# =================================================================
# StreamDocs - Backend Environment Configuration Example
# =================================================================

DOMAIN=localhost
ENVIRONMENT=local
PROJECT_NAME="StreamDocs"
STACK_NAME=streamdocs

SECRET_KEY=changethis-secret-key-at-least-32-chars-long
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis123

FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000"

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/documents
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=documents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./data/uploads
CELERY_WORKER_CONCURRENCY=2

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SMTP_TLS=true
SMTP_SSL=false

SENTRY_DSN=
